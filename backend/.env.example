# ================================
# TILI Backend Environment Variables
# ================================

# Application
NODE_ENV=development
PORT=3001

# MongoDB
MONGODB_URI=mongodb://localhost:27017/tili

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookie Settings
COOKIE_DOMAIN=localhost

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Encryption Key (for sensitive data like integration tokens)
# Must be at least 32 characters in production
ENCRYPTION_KEY=your-encryption-key-at-least-32-chars

# ================================
# Trello Integration (Optional)
# ================================
# Required for Trello integration features
# Get your API key from: https://trello.com/app-key

# Trello API Key (required for integration)
TRELLO_API_KEY=

# Default Board ID (optional - can be set per user)
TRELLO_DEFAULT_BOARD_ID=

# Default List ID (optional - can be set per user)
TRELLO_DEFAULT_LIST_ID=
